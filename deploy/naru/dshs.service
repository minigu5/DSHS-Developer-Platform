# DSHS 개발자 플랫폼(Next.js) — /etc/systemd/system/dshs.service (2026-11-11)
# 전용 계정 dshs-app 으로, 쓰기는 /srv/dshs 만. 비밀 값은 /srv/dshs/.env(600)에만 있다.
# DSHS_RUNTIME=node: 코드가 Cloudflare 바인딩 대신 Node 경로를 쓴다(src/lib/runtime.ts).
# NEXT_MANUAL_SIG_HANDLE=true: 멈출 때 Next 가 바로 나가지 않고 앱이 포스터 일감을 최대 100초 기다린다(src/instrumentation.ts).
[Unit]
Description=DSHS developer platform (Next.js)
Requires=dshs.socket
After=network-online.target dshs.socket
Wants=network-online.target

[Service]
User=dshs-app
Group=dshs-app
WorkingDirectory=/srv/dshs/current
EnvironmentFile=/srv/dshs/.env
Environment=NODE_ENV=production DSHS_RUNTIME=node NEXT_MANUAL_SIG_HANDLE=true NEXT_TELEMETRY_DISABLED=1
# -H·-p 는 요청 주소(request.url)를 만드는 값이다 — 실제 포트는 dshs.socket 의 8080(preload.js 가 넘겨받음). 공개 호스트는 .env 의 NEXT_PUBLIC_SITE_URL 에서.
# ($$ 는 systemd 가 아니라 sh 가 풀게 하는 표시)
ExecStart=/bin/sh -c 'exec /usr/bin/node --require /srv/dshs/preload.js node_modules/next/dist/bin/next start -H "$${NEXT_PUBLIC_SITE_URL#https://}" -p 443'
TimeoutStopSec=120
Restart=always
RestartSec=3

UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/dshs
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# AF_NETLINK: next start 가 켜질 때 os.networkInterfaces() 를 부른다 — 막으면 EAFNOSUPPORT 로 멈춰 요청이 영영 안 끝남(2026-11-11)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
