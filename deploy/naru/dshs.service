# DSHS 개발자 플랫폼(Next.js) — /etc/systemd/system/dshs.service (2026-11-11)
# 전용 계정 dshs-app 으로, 쓰기는 지금 릴리스의 .next/cache 만. 비밀 값은 /etc/dshs/env(root 600)에만 — systemd 가 읽어 넘긴다.
# DSHS_RUNTIME=node: 코드가 Cloudflare 바인딩 대신 Node 경로를 쓴다(src/lib/runtime.ts).
# NEXT_MANUAL_SIG_HANDLE=true: 멈출 때 Next 가 바로 나가지 않고 앱이 포스터 일감을 최대 100초 기다린다(src/instrumentation.ts).
[Unit]
Description=DSHS developer platform (Next.js)
Requires=dshs.socket
After=network-online.target dshs.socket
Wants=network-online.target

[Service]
User=dshs-app
Group=dshs-app
WorkingDirectory=/srv/dshs/current
EnvironmentFile=/etc/dshs/env
Environment=NODE_ENV=production DSHS_RUNTIME=node NEXT_MANUAL_SIG_HANDLE=true NEXT_TELEMETRY_DISABLED=1
# preload.js 가 `start` 뒤에 -H <NEXT_PUBLIC_SITE_URL 의 호스트> -p 443 을 붙인다(요청 주소용 — 실제 포트는 dshs.socket 의 8080).
ExecStart=/usr/bin/node --require /usr/local/lib/dshs/preload.js node_modules/next/dist/bin/next start
TimeoutStopSec=120
Restart=always
RestartSec=3
# 빌드가 메모리를 다 쓰면 커널이 앱보다 빌드를 먼저 죽이게(dshs-deploy.service 는 +500)
OOMScoreAdjust=-500

UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
# 지금 릴리스의 캐시만 쓴다(시작할 때 current 링크가 풀린 경로) — 되돌릴 이전 릴리스·새 릴리스는 못 고친다(2026-11-12 보안 점검)
ReadWritePaths=-/srv/dshs/current/.next/cache
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# AF_NETLINK: next start 가 켜질 때 os.networkInterfaces() 를 부른다 — 막으면 EAFNOSUPPORT 로 멈춰 요청이 영영 안 끝남(2026-11-11)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
