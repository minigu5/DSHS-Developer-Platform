# 8080 방화벽 — /etc/systemd/system/dshs-firewall.service (2026-11-11). dshs.socket 이 이것을 Requires 하므로
# 이게 안 켜지면 소켓도 안 열리고, 이걸 멈추면 소켓도 같이 멈춘다(부팅 직후 방화벽 없이 8080 이 열리는 틈 없음).
# 소켓은 부팅 초기(sockets.target)에 열리므로 기본 순서(basic.target 뒤)를 끄고 그보다 먼저 켠다 — 안 그러면 순서가 돌고 돈다.
[Unit]
Description=DSHS developer platform firewall (8080)
DefaultDependencies=no
After=local-fs.target
Before=sockets.target dshs.socket shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /usr/local/lib/dshs/firewall.nft
ExecStop=/usr/sbin/nft delete table inet dshs

[Install]
WantedBy=sockets.target
