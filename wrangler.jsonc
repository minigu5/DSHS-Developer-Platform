// Cloudflare Workers 배포 설정 (OpenNext). 설명: docs/19-cloudflare-workers.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dshs-developer-platform",
  // 개인 계정(Seong381400@gmail.com) — dshs.dev 영역이 있는 계정
  "account_id": "370e521d89a70d895de8448a36449b93",
  // OpenNext 의 .open-next/worker.js 를 감싸 AI 포스터 큐 소비자를 더한 진입점(custom-worker.ts)
  "main": "custom-worker.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // esbuild가 넣는 __name() 도우미가 next-themes의 인라인 스크립트(함수.toString())에 섞여
  // 브라우저에서 "__name is not defined"로 다크모드 초기화가 깨지는 문제 방지
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "dshs-developer-platform" }
  ],
  // Supabase(AWS 서울)와 자주 왕복하므로 Worker를 DB 가까이에서 실행 (smart 모드는 트래픽이 쌓여야 작동)
  "placement": { "region": "aws:ap-northeast-2" },
  "observability": { "enabled": true },

  // next/image 최적화
  "images": { "binding": "IMAGES" },

  // AI 포스터 그림(flux-2-klein) — 무료 10,000 neurons/일, 계정 전체 공유
  "ai": { "binding": "AI" },

  // AI 포스터 만들기·고치기·다시 그리기 일감(탭을 닫아도 끝까지) — 큐는 `npx wrangler queues create poster-jobs`로 미리 만든다
  // (없으면 배포가 실패). 무료 하루 10,000 operations(메시지 하나 ≈ 3), 보존 24시간, 소비자 한 번 최대 15분.
  // 소비자는 custom-worker.ts queue() — 일감 하나씩, 실패하면 10초 뒤 두 번까지 다시(내부 경로가 이미 잡힌 일감은 건너뜀).
  "queues": {
    "producers": [{ "queue": "poster-jobs", "binding": "POSTER_JOBS" }],
    "consumers": [{ "queue": "poster-jobs", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 2 }]
  },

  // 매일 03:15 KST(UTC 18:15) 파비콘 동기화 — custom-worker.ts scheduled(). 무료 요금제는 계정 전체 예약 5개까지
  "triggers": { "crons": ["15 18 * * *"] },

  // 비밀이 아닌 런타임 값. 비밀은 `npx wrangler secret put <이름>`으로.
  "vars": {
    "ALLOWED_EMAIL_DOMAIN": "ts.hs.kr",
    // 도메인 마련하기(서브도메인) — dshs.dev 존. 토큰은 secret CLOUDFLARE_DNS_API_TOKEN
    "CLOUDFLARE_ZONE_ID": "c9fac6d72c704d4836b837590f18e144",
    // 바로가기 주소(Workers·Firebase) — 계정의 Bulk Redirect 목록. 토큰은 secret CLOUDFLARE_LISTS_API_TOKEN
    "CLOUDFLARE_ACCOUNT_ID": "370e521d89a70d895de8448a36449b93",
    "CLOUDFLARE_REDIRECT_LIST_ID": "f31dbc9f2bbb42deb5aea342330b41b5"
  }

  // dshs.dev 영역이 이 계정에 추가된 뒤 주석 해제 (위 "vars" 블록 끝에 쉼표 추가)
  // "routes": [
  //   { "pattern": "dshs.dev", "custom_domain": true },
  //   { "pattern": "www.dshs.dev", "custom_domain": true }
  // ]
}
