// Cloudflare Workers 배포 설정 (OpenNext). 설명: docs/19-cloudflare-workers.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dshs-developer-platform",
  // 개인 계정(Seong381400@gmail.com) — dshs.dev 영역이 있는 계정
  "account_id": "370e521d89a70d895de8448a36449b93",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // esbuild가 넣는 __name() 도우미가 next-themes의 인라인 스크립트(함수.toString())에 섞여
  // 브라우저에서 "__name is not defined"로 다크모드 초기화가 깨지는 문제 방지
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "dshs-developer-platform" }
  ],
  // Supabase(AWS 서울)와 자주 왕복하므로 Worker를 DB 가까이에서 실행 (smart 모드는 트래픽이 쌓여야 작동)
  "placement": { "region": "aws:ap-northeast-2" },
  "observability": { "enabled": true },

  // next/image 최적화
  "images": { "binding": "IMAGES" },

  // 비밀이 아닌 런타임 값. 비밀은 `npx wrangler secret put <이름>`으로.
  "vars": {
    "ALLOWED_EMAIL_DOMAIN": "ts.hs.kr",
    // 도메인 마련하기(서브도메인) — dshs.dev 존. 토큰은 secret CLOUDFLARE_DNS_API_TOKEN
    "CLOUDFLARE_ZONE_ID": "c9fac6d72c704d4836b837590f18e144"
  }

  // dshs.dev 영역이 이 계정에 추가된 뒤 주석 해제 (위 "vars" 블록 끝에 쉼표 추가)
  // "routes": [
  //   { "pattern": "dshs.dev", "custom_domain": true },
  //   { "pattern": "www.dshs.dev", "custom_domain": true }
  // ]
}
